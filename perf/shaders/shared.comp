#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer Out { float dst[]; };
layout(push_constant) uniform PC { uint stride; } pc;
shared float tile[8192];
void main() {
  uint t = gl_LocalInvocationID.x;
  uint idx = t * pc.stride;
  tile[idx] = float(t);
  barrier();
  float v = tile[idx];
  barrier();
  dst[gl_GlobalInvocationID.x] = v;
}
