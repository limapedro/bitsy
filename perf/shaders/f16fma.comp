#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer In { f16vec2 src[]; };
layout(std430, binding = 1) writeonly buffer Out { f16vec2 dst[]; };
layout(push_constant) uniform PC { uint n, loops; } pc;
void main() {
  uint gid = gl_GlobalInvocationID.x;
  if (gid >= pc.n) return;
  f16vec2 a = src[gid & 1023u];
  f16vec2 acc = a;
  for (uint k = 0; k < pc.loops; ++k) {
    acc = fma(acc, f16vec2(1.0001, 1.0002), src[(gid + k) & 1023u]);
  }
  dst[gid] = acc;
}
