#version 450
/* exp_012: aligned vec4 elementwise fast path. One 16-byte load/store per
 * input per lane and a linear index (no runtime div/mod). The push-constant
 * layout matches elementwise.comp so the host can reuse vk_pc_t. */
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer A { vec4 avec[]; };
layout(std430, binding = 1) readonly buffer B { vec4 bvec[]; };
layout(std430, binding = 2) writeonly buffer O { vec4 ovec[]; };

layout(push_constant) uniform PC {
  uint n, ndim, op;
  int dims[8];
  int sa[8], sb[8], so[8];
  int offa, offb, offo;
} pc;

void main() {
  uint idx = gl_GlobalInvocationID.x;
  if (idx >= pc.n) return;
  vec4 av = avec[idx], bv = bvec[idx];
  precise vec4 r;
  if (pc.op == 0) r = av + bv;
  else if (pc.op == 1) r = av - bv;
  else if (pc.op == 2) r = av * bv;
  else if (pc.op == 3) r = vec4(dvec4(av) / dvec4(bv));
  else if (pc.op == 4) r = max(av, vec4(0.0));
  else if (pc.op == 5) r = vec4(1.0) / (vec4(1.0) + exp(-av));
  else if (pc.op == 6) r = tanh(av);
  else if (pc.op == 7) r = exp(av);
  else if (pc.op == 10) r = log(av);
  else r = av;
  ovec[idx] = r;
}
