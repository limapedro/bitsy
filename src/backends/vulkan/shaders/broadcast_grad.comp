#version 450
/* exp_020: reduce-sum backward. Writes a full-shape CONTIGUOUS gradient from
 * the small reduction gradient (size-1 axes repeat), avoiding both a ones
 * tensor and unsafe stride-0 views. */
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer G { float g[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC {
  uint n, outN, gM, gN;
  int gs0, gs1;
} pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  uint r = i / pc.outN;
  uint c = i - r * pc.outN;
  int gi = (pc.gM == 1 ? 0 : int(r)) * pc.gs0 +
           (pc.gN == 1 ? 0 : int(c)) * pc.gs1;
  o[i] = g[gi];
}
