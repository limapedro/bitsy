#version 450
/* exp_018: 2D axis reduction sum. One thread per output element loops over the
 * reduced axis; replaces tiny ones-vector GEMMs with a single workgroup. */
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint M, N, axis; int sa0, sa1, off; } pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (pc.axis == 1) {          // sum rows -> M outputs
    if (i >= pc.M) return;
    float s = 0.0;
    for (uint j = 0; j < pc.N; ++j) s += a[pc.off + int(i) * pc.sa0 + int(j) * pc.sa1];
    o[i] = s;
  } else {                     // sum columns -> N outputs
    if (i >= pc.N) return;
    float s = 0.0;
    for (uint r = 0; r < pc.M; ++r) s += a[pc.off + int(r) * pc.sa0 + int(i) * pc.sa1];
    o[i] = s;
  }
}
