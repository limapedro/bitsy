#version 450
/* exp_028: fused cross-entropy loss = -sum(onehot * log_softmax) / B.
 * One workgroup reduces all B*C elements into a single scalar. */
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer LS { float ls[]; };
layout(std430, binding = 1) readonly buffer OH { float onehot[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint n; float invB; uint offls, offoh, offo; } pc;
shared float partial[256];
void main() {
  uint tid = gl_LocalInvocationID.x;
  float v = (tid < pc.n) ? ls[pc.offls + tid] * onehot[pc.offoh + tid] : 0.0;
  partial[tid] = v;
  barrier();
  for (uint stride = 128; stride > 0; stride >>= 1) {
    if (tid < stride) partial[tid] += partial[tid + stride];
    barrier();
  }
  if (tid == 0) o[pc.offo] = -partial[0] * pc.invB;
}
