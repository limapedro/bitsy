#version 450
/* exp_019: fused tanh backward: grad = g * (1 - out*out), same fp32 order as
 * the unfused chain (square, subtract, multiply). */
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer G { float g[]; };
layout(std430, binding = 1) readonly buffer T { float t[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  float sq = t[i] * t[i];
  float d = 1.0 - sq;
  o[i] = g[i] * d;
}
