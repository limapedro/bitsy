#version 450
/* Sum SPLITS partial GEMM results laid out contiguously in binding 0. */
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer P { float partial[]; };
layout(std430, binding = 2) writeonly buffer O { float outv[]; };
layout(push_constant) uniform PC { uint n, splits; } pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  float sum = 0.0;
  for (uint s = 0; s < pc.splits; ++s) sum += partial[s * pc.n + i];
  outv[i] = sum;
}
