#version 450

/* exp_002: 16x16x16 shared-memory tiled SGEMM. Each workgroup reuses A/B tiles
 * from shared memory instead of reloading them from device memory per output. */
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) writeonly buffer C { float c[]; };

layout(push_constant) uniform PC {
  uint M, N, K;
  int sa0, sa1, sb0, sb1, sc0, sc1;
  int offa, offb, offc;
  int k_start, k_len;
} pc;

shared float Atile[16][16];
shared float Btile[16][16];

void main() {
  int i = int(gl_GlobalInvocationID.y), j = int(gl_GlobalInvocationID.x);
  int ti = int(gl_LocalInvocationID.y), tj = int(gl_LocalInvocationID.x);
  float sum = 0.0;
  int k_end = pc.k_start + pc.k_len;
  for (int k0 = pc.k_start; k0 < k_end; k0 += 16) {
    int ak = k0 + tj, bk = k0 + ti;
    Atile[ti][tj] = (i < int(pc.M) && ak < k_end)
      ? a[pc.offa + i * pc.sa0 + ak * pc.sa1] : 0.0;
    Btile[ti][tj] = (j < int(pc.N) && bk < k_end)
      ? b[pc.offb + bk * pc.sb0 + j * pc.sb1] : 0.0;
    barrier();
    for (int kk = 0; kk < 16; ++kk) sum += Atile[ti][kk] * Btile[kk][tj];
    barrier();
  }
  if (i < int(pc.M) && j < int(pc.N))
    c[pc.offc + i * pc.sc0 + j * pc.sc1] = sum;
}
