#version 450
/* exp_022: mul-backward two gradients in one dispatch: out[0..n) = g*a,
 * out[n..2n) = g*b. Operands may be 2D/broadcast (size-1 axes repeat). */
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer G { float g[]; };
layout(std430, binding = 1) readonly buffer A { float a[]; };
layout(std430, binding = 2) readonly buffer B { float b[]; };
layout(std430, binding = 3) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC {
  uint n, M, N;
  uint aM, aN, bM, bN;
  int sa0, sa1, sb0, sb1;
  int offg, offa, offb;
} pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  uint r = i / pc.N;
  uint c = i - r * pc.N;
  int ia = (pc.aM == 1 ? 0 : int(r)) * pc.sa0 +
           (pc.aN == 1 ? 0 : int(c)) * pc.sa1;
  int ib = (pc.bM == 1 ? 0 : int(r)) * pc.sb0 +
           (pc.bN == 1 ? 0 : int(c)) * pc.sb1;
  o[i] = g[pc.offg + i] * a[pc.offa + ia];
  o[pc.n + i] = g[pc.offg + i] * b[pc.offb + ib];
}
