#version 450
/* exp_017: fused SGD weight update, W - lr*grad, in one dispatch. The learning
 * rate is a push-constant float, so no per-parameter lr upload is needed. */
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer W { float w[]; };
layout(std430, binding = 1) readonly buffer G { float g[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint n; float lr; } pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  o[i] = w[i] - pc.lr * g[i];
}
