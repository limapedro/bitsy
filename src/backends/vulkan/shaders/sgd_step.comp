#version 450
/* exp_019: fused SGD update with stride-aware operands so zero-dispatch
 * broadcast gradients (stride 0) cannot be misread. */
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer W { float w[]; };
layout(std430, binding = 1) readonly buffer G { float g[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC {
  uint n, M, N;
  float lr;
  int sa0, sa1, sb0, sb1, sc0, sc1;
  int offw, offg, offo;
} pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  int r = int(i / pc.N);
  int c = int(i - uint(r) * pc.N);
  o[pc.offo + r * pc.sc0 + c * pc.sc1] =
      w[pc.offw + r * pc.sa0 + c * pc.sa1] -
      pc.lr * g[pc.offg + r * pc.sb0 + c * pc.sb1];
}
