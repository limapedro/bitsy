#version 450
/* exp_037: exact (erf) GELU and its derivative. Mode 0: out=gelu(x);
 * mode 1: out=g*(0.5*(1+erf(x/sqrt2)) + x*phi(x)). erf uses Abramowitz-Stegun
 * 7.1.26 (max error ~1.5e-7), matching PyTorch's default GELU within 1e-5. */
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer G { float gbuf[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint n, mode, offx, offg, offo; } pc;

float erf_approx(float xv) {
  float s = xv < 0.0 ? -1.0 : 1.0;
  float ax = abs(xv);
  float t = 1.0 / (1.0 + 0.3275911 * ax);
  float p = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t
              - 0.284496736) * t + 0.254829592) * t;
  return s * (1.0 - p * exp(-ax * ax));
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  float xv = x[pc.offx + i];
  float e = erf_approx(xv * 0.7071067811865476);
  float base = 0.5 * (1.0 + e);
  if (pc.mode == 0) o[pc.offo + i] = xv * base;
  else {
    float phi = 0.3989422804014327 * exp(-0.5 * xv * xv);
    o[pc.offo + i] = gbuf[pc.offg + i] * (base + xv * phi);
  }
}
