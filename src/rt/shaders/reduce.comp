#version 450
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
/* Bitsy 0.2 generic reduction along one axis. kind: 0=sum 1=mean 2=max 3=min.
 * One WORKGROUP per (outer,inner) output line; all 256 invocations cooperate:
 * each thread accumulates a strided slice of the reduction axis, then a shared-
 * memory tree reduction combines them. Previously one INVOCATION handled the
 * whole line -> a 1M 1-D reduce ran single-threaded (~800x slower than torch).
 */
layout(local_size_x = 256) in;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer F32 {
  float v[];
};
/* params: [0]=outer [1]=stride [2]=inner [3]=kind, [4]=Inaddr [6]=Outaddr */
layout(std430, binding = 0) readonly buffer Params { int param[]; };
uint64_t paddr(int base) {
  return (uint64_t(uint(param[base])) | (uint64_t(uint(param[base + 1])) << 32));
}

shared float part[256];

float combine(int kind, float a, float b) {
  if (kind == 2) return max(a, b);
  if (kind == 3) return min(a, b);
  return a + b;
}

void main() {
  int outer = param[0], stride = param[1], inner = param[2], kind = param[3];
  F32 In = F32(paddr(4)), Out = F32(paddr(6));
  int line = int(gl_WorkGroupID.x);
  int tid = int(gl_LocalInvocationID.x);
  int o = line / inner, t = line % inner;

  float init = (kind == 2) ? -1.0/0.0 : ((kind == 3) ? 1.0/0.0 : 0.0);
  float s = init;
  for (int k = tid; k < stride; k += 256) {
    float v = In.v[(o * stride + k) * inner + t];
    s = combine(kind, s, v);
  }
  part[tid] = s;
  barrier();
  for (int off = 128; off > 0; off >>= 1) {
    if (tid < off) part[tid] = combine(kind, part[tid], part[tid + off]);
    barrier();
  }
  if (tid == 0) {
    if (kind == 1) part[0] /= float(stride);
    Out.v[line] = part[0];
  }
}
