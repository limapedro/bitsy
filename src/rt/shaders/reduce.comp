#version 450
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
/* Bitsy 0.2 two-stage reduction. kind: 0=sum 1=mean 2=max 3=min.
 * STAGE=0: (lines x NPART) workgroups; each reduces a chunk of one output line
 *          with 256 threads into a partial buffer (uses all SMs).
 * STAGE=1: ceil(lines/256) workgroups; each thread reduces NPART partials of
 *          one output line into the final result.
 * Both dispatches are recorded in one command buffer (one submit/fence).
 */
layout(local_size_x = 256) in;
layout(constant_id = 0) const int STAGE = 0;
layout(constant_id = 1) const int NPART = 64;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer F32 {
  float v[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer F32W {
  float v[];
};
/* params: [0]=outer [1]=stride [2]=inner [3]=kind,
 * [4]=Inaddr [6]=Partaddr [8]=Outaddr, [10]=total output lines */
layout(std430, binding = 0) readonly buffer Params { int param[]; };
uint64_t paddr(int base) {
  return (uint64_t(uint(param[base])) | (uint64_t(uint(param[base + 1])) << 32));
}

shared float part[256];

float combine(int kind, float a, float b) {
  if (kind == 2) return max(a, b);
  if (kind == 3) return min(a, b);
  return a + b;
}
float initval(int kind) {
  return (kind == 2) ? -1.0/0.0 : ((kind == 3) ? 1.0/0.0 : 0.0);
}

void main() {
  int kind = param[3];
  int tid = int(gl_LocalInvocationID.x);
  F32 Part = F32(paddr(6));

  if (STAGE == 0) {
    int outer = param[0], stride = param[1], inner = param[2];
    F32 In = F32(paddr(4));
    int line = int(gl_WorkGroupID.x);
    int o = line / inner, t = line % inner;
    int chunk = (stride + NPART - 1) / NPART;
    int k0 = int(gl_WorkGroupID.y) * chunk;
    int k1 = min(k0 + chunk, stride);
    float s = initval(kind);
    for (int k = k0 + tid; k < k1; k += 256)
      s = combine(kind, s, In.v[(o * stride + k) * inner + t]);
    part[tid] = s;
    barrier();
    for (int off = 128; off > 0; off >>= 1) {
      if (tid < off) part[tid] = combine(kind, part[tid], part[tid + off]);
      barrier();
    }
    if (tid == 0) Part.v[line * NPART + int(gl_WorkGroupID.y)] = part[0];
  } else {
    int line = int(gl_GlobalInvocationID.x);
    if (line >= param[10]) return;
    float s = initval(kind);
    for (int i = 0; i < NPART; ++i) s = combine(kind, s, Part.v[line * NPART + i]);
    if (kind == 1) s /= float(param[1]);
    F32W Out = F32W(paddr(8));
    Out.v[line] = s;
  }
}
