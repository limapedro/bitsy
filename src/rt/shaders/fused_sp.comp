#version 450
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
/* Specialized fused pointwise kernel (PR #7). The op-program is baked into
 * specialization constants so op-codes are compile-time literals: no global
 * op-code reads per element, no dynamic stack indexing. Up to 8 instructions.
 *
 * Operand indices: 0..7 = loaded input slots, 8..15 = instruction results.
 * Op 0 = NOP (unused step). Unary ops (5-13,18,19) use A; binary (1-4,14-17,20-26) use A,B.
 * Spec ids: 0=NOPS, 1..8=OP0..7, 9..16=A0..7, 17..24=B0..7.
 */
layout(local_size_x = 256) in;
layout(constant_id = 0) const int NOPS = 0;
layout(constant_id = 1) const int OP0 = 0;  layout(constant_id = 2) const int OP1 = 0;
layout(constant_id = 3) const int OP2 = 0;  layout(constant_id = 4) const int OP3 = 0;
layout(constant_id = 5) const int OP4 = 0;  layout(constant_id = 6) const int OP5 = 0;
layout(constant_id = 7) const int OP6 = 0;  layout(constant_id = 8) const int OP7 = 0;
layout(constant_id = 9) const int A0 = 0;   layout(constant_id = 10) const int A1 = 0;
layout(constant_id = 11) const int A2 = 0;  layout(constant_id = 12) const int A3 = 0;
layout(constant_id = 13) const int A4 = 0;  layout(constant_id = 14) const int A5 = 0;
layout(constant_id = 15) const int A6 = 0;  layout(constant_id = 16) const int A7 = 0;
layout(constant_id = 17) const int B0 = 0;  layout(constant_id = 18) const int B1 = 0;
layout(constant_id = 19) const int B2 = 0;  layout(constant_id = 20) const int B3 = 0;
layout(constant_id = 21) const int B4 = 0;  layout(constant_id = 22) const int B5 = 0;
layout(constant_id = 23) const int B6 = 0;  layout(constant_id = 24) const int B7 = 0;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer F32 { float v[]; };
/* params: [0]=n [1]=ninputs [2]=ndim [3..6]=dims [7+s*4..]=stride of input s
 * [40..41]=out addr [42+s*2..]=input s addr */
layout(std430, binding = 0) readonly buffer Params { int param[]; };
uint64_t paddr(int b){ return uint64_t(uint(param[b])) | (uint64_t(uint(param[b+1])) << 32); }

float apply1(int op, float x){
  if(op==5) return -x;
  if(op==6) return exp(x);
  if(op==7) return log(x);
  if(op==8) return sqrt(max(x,0.0));
  if(op==9) return tanh(x);
  if(op==10) return 1.0/(1.0+exp(-x));
  if(op==11) return x>0.0?x:0.0;
  if(op==12||op==14){ float s=x<0.0?-1.0:1.0, ax=abs(x)*0.70710678;
    float t=1.0/(1.0+0.3275911*ax);
    float p=((((1.061405429*t-1.453152027)*t+1.421413741)*t-0.284496736)*t+0.254829592)*t;
    return x*0.5*(1.0+s*(1.0-p*exp(-ax*ax))); }
  if(op==13) return x>0.0?1.0:0.0;
  if(op==18) return abs(x);
  if(op==19) return x>0.0?1.0:(x<0.0?-1.0:0.0);
  return x;
}
float apply2(int op, float a, float b){
  if(op==1) return a+b;  if(op==2) return a-b;  if(op==3) return a*b;
  if(op==4) return b!=0.0?a/b:0.0;
  if(op==14){ float s=b<0.0?-1.0:1.0, ax=abs(b)*0.70710678;
    float t=1.0/(1.0+0.3275911*ax);
    float p=((((1.061405429*t-1.453152027)*t+1.421413741)*t-0.284496736)*t+0.254829592)*t;
    return a*(0.5*(1.0+s*(1.0-p*exp(-ax*ax)))+b*0.39894228*exp(-0.5*b*b)); }
  if(op==15) return pow(a,b);
  if(op==16) return max(a,b); if(op==17) return min(a,b);
  if(op==20) return a>b?1.0:0.0; if(op==21) return a>=b?1.0:0.0;
  if(op==22) return a<b?1.0:0.0; if(op==23) return a<=b?1.0:0.0;
  if(op==24) return a==b?1.0:0.0; if(op==25) return a!=b?1.0:0.0;
  return a;
}
bool is_unary(int op){ return op==5||op==6||op==7||op==8||op==9||op==10||op==11||op==12||op==13||op==18||op==19; }
float val(int idx, float ld[8], float r[8]){
  if(idx<8) return ld[idx]; return r[idx-8];
}
void main(){
  uint i = gl_GlobalInvocationID.x;
  if (i >= uint(param[0])) return;
  int nd = param[2];
  int coord[4]; int rem = int(i);
  for (int j=nd-1;j>=0;--j){ coord[j]=rem%param[3+j]; rem/=param[3+j]; }
  int ni = param[1];
  float ld[8];
  for (int s=0;s<ni;++s){
    int64_t off=0;
    for (int j=0;j<nd;++j) off += int64_t(coord[j])*int64_t(param[7+s*4+j]);
    ld[s] = F32(paddr(42+s*2)).v[int(off)];
  }
  float r[8];
  for(int k=0;k<NOPS;++k){
    int op, aa, bb;
    if(k==0){op=OP0;aa=A0;bb=B0;} else if(k==1){op=OP1;aa=A1;bb=B1;}
    else if(k==2){op=OP2;aa=A2;bb=B2;} else if(k==3){op=OP3;aa=A3;bb=B3;}
    else if(k==4){op=OP4;aa=A4;bb=B4;} else if(k==5){op=OP5;aa=A5;bb=B5;}
    else if(k==6){op=OP6;aa=A6;bb=B6;} else {op=OP7;aa=A7;bb=B7;}
    if(op==0) continue;
    if(is_unary(op)) r[k]=apply1(op, val(aa,ld,r));
    else r[k]=apply2(op, val(aa,ld,r), val(bb,ld,r));
  }
  /* last active instruction result */
  float outv=0.0;
  for(int k=NOPS-1;k>=0;--k){ int op; if(k==0)op=OP0;else if(k==1)op=OP1;else if(k==2)op=OP2;
    else if(k==3)op=OP3;else if(k==4)op=OP4;else if(k==5)op=OP5;else if(k==6)op=OP6;else op=OP7;
    if(op!=0){ outv=r[k]; break; } }
  F32(paddr(40)).v[i] = outv;
}
