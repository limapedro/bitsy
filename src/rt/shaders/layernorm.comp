#version 450
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
/* Bitsy 0.2 fused LayerNorm over the last dimension (<=256 cols).
 * One workgroup per row: load row, tree-reduce mean, tree-reduce variance,
 * then y = (x-mean)*rsqrt(var+eps)*weight + bias. All in one dispatch.
 * params: [0]=rows [1]=cols [2]=eps-bits [4]=In [6]=Weight [8]=Bias [10]=Out [12]=Residual */
layout(local_size_x = 256) in;
layout(constant_id = 0) const int HAS_RES = 0;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer F32 {
  float v[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer F32W {
  float v[];
};
layout(std430, binding = 0) readonly buffer Params { int param[]; };
uint64_t paddr(int b){ return uint64_t(uint(param[b])) | (uint64_t(uint(param[b+1]))<<32); }

shared float smem[256];
shared float red[256];

void main(){
  int rows=param[0], cols=param[1];
  float eps; uint ebits=uint(param[2]); eps=uintBitsToFloat(ebits);
  int row=int(gl_WorkGroupID.x), tid=int(gl_LocalInvocationID.x);
  if(row>=rows) return;
  F32 In=F32(paddr(4)), W=F32(paddr(6)), B=F32(paddr(8));
  F32 Res=F32(paddr(12));
  F32W Out=F32W(paddr(10));

  for(int i=tid;i<cols;i+=256) smem[i]=In.v[row*cols+i]+(HAS_RES==1?Res.v[row*cols+i]:0.0);
  barrier();
  /* mean */
  float s=0.0; for(int i=tid;i<cols;i+=256) s+=smem[i];
  red[tid]=s; barrier();
  for(int off=128;off>0;off>>=1){ if(tid<off) red[tid]+=red[tid+off]; barrier(); }
  float mean=red[0]/float(cols);
  /* variance: reuse smem for (x-mean)^2 */
  float v=0.0; for(int i=tid;i<cols;i+=256){ float d=smem[i]-mean; smem[i]=d; v+=d*d; }
  red[tid]=v; barrier();
  for(int off=128;off>0;off>>=1){ if(tid<off) red[tid]+=red[tid+off]; barrier(); }
  float var=red[0]/float(cols);
  float scale=inversesqrt(var+eps);
  for(int i=tid;i<cols;i+=256)
    Out.v[row*cols+i]=smem[i]*scale*W.v[i]+B.v[i];
}
