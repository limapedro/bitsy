#version 450
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
/* Bitsy 0.2 tiled GEMM with optional bias epilogue and transpose flags.
 * Y = opA(A) @ opB(B) + bias, where opX is transpose if the flag is set.
 * Tile sizes BM/BN/BK are specialization constants (BEAM-lite autotune). */
layout(local_size_x = 256) in;
layout(constant_id = 0) const int BM = 16;
layout(constant_id = 1) const int BN = 16;
layout(constant_id = 2) const int BK = 16;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer F32 {
  float v[];
};
/* params words:
 * [0]=M [1]=N [2]=K [3]=flags(bit0=transA,bit1=transB,bit2=has_bias)
 * [4]=arows [5]=acols [6]=brows [7]=bcols
 * [8]=Aaddr [10]=Baddr [12]=Caddr [14]=biasaddr (2 words each) */
/* NOTE: addresses are packed 2 words each at 8/10/12/14 to match rt_vk.c. */
layout(std430, binding = 0) readonly buffer Params { int param[]; };
uint64_t paddr(int base) {
  return (uint64_t(uint(param[base])) | (uint64_t(uint(param[base + 1])) << 32));
}
void main() {
  int M = param[0], N = param[1], K = param[2];
  int flags = param[3];
  bool ta = (flags & 1) != 0, tb = (flags & 2) != 0, hb = (flags & 4) != 0;
  int ar = param[4], ac = param[5], br = param[6], bc = param[7];
  F32 A = F32(paddr(8)), B = F32(paddr(10)), C = F32(paddr(12));
  F32 bias = F32(paddr(14));
  int tile = int(gl_WorkGroupID.x);
  int tid = int(gl_LocalInvocationID.x);
  int tilesN = (N + BN - 1) / BN;
  int row = (tile / tilesN) * BM;
  int col = (tile % tilesN) * BN;
  if (row >= M || col >= N) return;
  int threads = int(gl_WorkGroupSize.x);
  for (int e = 0; e < BM * BN; ++e) {
    int r = row + e / BN, c = col + e % BN;
    if ((e % threads) != tid || r >= M || c >= N) continue;
    float acc = 0.0;
    for (int k = 0; k < K; ++k) {
      float av = ta ? A.v[k * M + r] : A.v[r * K + k];
      float bv = tb ? B.v[c * K + k] : B.v[k * N + c];
      acc += av * bv;
    }
    if (hb) acc += bias.v[c];
    C.v[r * N + c] = acc;
  }
}
